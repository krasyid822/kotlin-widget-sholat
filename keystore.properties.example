# Salin file ini menjadi keystore.properties dan isi sesuai keystore release Anda.
# File keystore.properties diabaikan oleh git (.gitignore).
#
# Contoh membuat keystore baru:
# keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias widgetsholat
storeFile=../release.jks
storePassword=GANTI_PASSWORD_KEYSTORE
keyAlias=widgetsholat
keyPassword=GANTI_PASSWORD_KEY
